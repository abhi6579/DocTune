# ── DocTune environment ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# Local development (Docker / local Postgres):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Vercel / hosted Postgres (Neon, Supabase, Vercel Postgres).
# SSL is enabled automatically when the URL contains sslmode=require:
# DATABASE_URL=postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require

# Optional: force SSL on/off explicitly (1 = force on)
# DB_SSL=1

# Optional: shown on paid pilot / team pricing links.
# In Vercel, add this as a public environment variable.
# NEXT_PUBLIC_SALES_EMAIL=you@company.com

# ── Wallet payments (Stripe) ──────────────────────────────────────
# Without these, top-ups run in DEMO mode and credit the wallet
# instantly (clearly marked as demo in the transaction history).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint to register in Stripe: https://your-domain/api/billing/stripe-webhook

# ── Free anonymous browser-demo allowance ─────────────────────────
# Free web evaluations per IP per day (default 20).
# WEB_FREE_DAILY=20
